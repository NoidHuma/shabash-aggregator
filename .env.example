# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SQLAlchemy async database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# VK
VK_TOKEN=put_vk_token_here
VK_POLL_INTERVAL=60
VK_POSTS_PER_REQUEST=50
VK_REQUESTS_PER_SECOND=3
VK_MAX_RETRIES=3
VK_REQUEST_TIMEOUT=10

VK_PUBLISH_GROUP_ID=0
VK_PUBLISH_TOKEN=put_vk_community_token_here
VK_PUBLISH_USER_TOKEN=put_vk_user_token_here

# Telegram
TG_API_ID=0
TG_API_HASH=put_tg_api_hash_here
TG_SESSION_NAME=tg_scraper
TG_POLL_INTERVAL=60
TG_MESSAGES_PER_REQUEST=50
TG_FLOOD_SLEEP_THRESHOLD=60

TG_CHANNEL=@your_channel
TG_BOT_TOKEN=put_bot_token_here

TG_BOT_DISPATCH_TOKEN=put_bot_token_here


# ML фильтр
ML_MODEL_PATH=models/relevance_clf.joblib

# ЛЛМ извлечение атрибутов
LLM_API_KEY=put_llm_api_key_here
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=ministral-14b-2512
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_REQUESTS_PER_SECOND=0.38
LLM_ENABLED=true
