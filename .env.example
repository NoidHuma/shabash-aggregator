# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SQLAlchemy async database URL
# Format:
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Telegram (client API via Telethon)
# Get TG_API_ID / TG_API_HASH at https://my.telegram.org -> API development tools.
TG_API_ID=0
TG_API_HASH=put_tg_api_hash_here
# Name of the Telethon session file (created on first login).
TG_SESSION_NAME=tg_scraper
# How often (seconds) the TG scraper polls active chats.
TG_POLL_INTERVAL=60
# How many recent messages to take from a chat per poll (and on first pass).
TG_MESSAGES_PER_REQUEST=50
# FloodWait delays up to this many seconds are awaited by Telethon automatically.
TG_FLOOD_SLEEP_THRESHOLD=60

# ML relevance classifier artifact (created by training script).
ML_MODEL_PATH=models/relevance_clf.joblib

# LLM for attribute extraction (OpenAI-compatible API; default = OpenRouter).
LLM_API_KEY=put_llm_api_key_here
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=ministral-14b-2512
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
# False = use stub (UNKNOWN/None) without calling the LLM.
LLM_ENABLED=true

# VK
# Put your real VK API token only into .env, not into this example file.
VK_TOKEN=put_vk_token_here
# How often (seconds) the VK scraper polls active communities.
VK_POLL_INTERVAL=60
# How many posts to request from wall.get per page (VK max is 100).
VK_POSTS_PER_REQUEST=50
# Global throttle: max VK API requests per second (VK allows ~3).
VK_REQUESTS_PER_SECOND=3
# Retries on VK error_code 6 (Too many requests) and network errors, with backoff.
VK_MAX_RETRIES=3
# Per-request HTTP timeout to VK API, seconds.
VK_REQUEST_TIMEOUT=10